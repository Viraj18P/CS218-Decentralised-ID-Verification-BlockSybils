      { "name": "sender",  "type": "address", "indexed": true }
    ]
  },
  {
    "type": "event",
    "name": "RoleRevoked",
    "inputs": [
      { "name": "role",    "type": "bytes32", "indexed": true },
      { "name": "account", "type": "address", "indexed": true },
      { "name": "sender",  "type": "address", "indexed": true }
    ]
  }
]