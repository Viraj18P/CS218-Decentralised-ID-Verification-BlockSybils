  {
    "type": "event",
    "name": "IdentityRegistered",
    "inputs": [
      { "name": "user",         "type": "address", "indexed": true  },
      { "name": "verifier",     "type": "address", "indexed": true  },
      { "name": "documentHash", "type": "bytes32", "indexed": true  },
